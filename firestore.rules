
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aturan untuk Production Mode: 
    // Izinkan publik untuk mengirim pesan (create) tapi tidak bisa baca/ubah pesan lain.
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // Tolak akses untuk koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
